# To separate your traces from other application
LANGSMITH_PROJECT=mdevtrade

# Add API keys for connecting to LLM providers, data sources, and other integrations here
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>

# LLM Provider (OpenAI-compatible)
LLM_BASE_URL=<your-endpoint>  # https://litellm-api.vinhmdev.com/v1
LLM_API_KEY=<your-key>
# LLM_FAST_MODEL=gemini/gemini-3-flash-preview
LLM_DEEP_MODEL=gemini/gemini-3-pro-preview

# Binance Spot Trading
BINANCE_API_KEY=<your-api-key>
BINANCE_SECRET_KEY=<your-secret-Key>
BINANCE_USE_TESTNET=True
ORDER_SIZE_USD=5.5
MAX_XAUT_INVENTORY_USD=5000.0

DATABASE_URI=postgres://user:password@localhost:5432/mdevtrade
REDIS_URI=redis://localhost:6379

# Path for trading memory database
TRADING_MEMORY_DB_PATH=/data/trading_memory.db